[
  {
    "name": "ui_tree",
    "description": "Read the guest UI Automation tree",
    "inputSchema": {
      "type": "object",
      "properties": {
        "machine": {
          "description": "Machine reference: a full MachineHandle object or an exact machine name string resolved through machine_list",
          "oneOf": [
            {
              "type": "object",
              "description": "MachineHandle returned by machine creation, machine_list, or checkpoint restore",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "state_dir": {
                  "type": "string"
                },
                "backend": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "state_dir",
                "backend",
                "state"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "description": "Exact machine name known to the control daemon"
            }
          ]
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 8
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "default": 2000
        },
        "view": {
          "type": "string",
          "enum": [
            "control",
            "raw"
          ],
          "default": "control"
        }
      },
      "required": [
        "machine"
      ]
    }
  },
  {
    "name": "ui_invoke",
    "description": "Invoke a UI element by tree node path",
    "inputSchema": {
      "type": "object",
      "properties": {
        "machine": {
          "description": "Machine reference: a full MachineHandle object or an exact machine name string resolved through machine_list",
          "oneOf": [
            {
              "type": "object",
              "description": "MachineHandle returned by machine creation, machine_list, or checkpoint restore",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "state_dir": {
                  "type": "string"
                },
                "backend": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "state_dir",
                "backend",
                "state"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "description": "Exact machine name known to the control daemon"
            }
          ]
        },
        "node": {
          "type": "string",
          "pattern": "^0(/[0-9]+)*$"
        },
        "view": {
          "type": "string",
          "enum": [
            "control",
            "raw"
          ],
          "default": "control"
        },
        "runtime_id": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.-?[0-9]+)*$"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 30000
        }
      },
      "required": [
        "machine",
        "node"
      ]
    }
  },
